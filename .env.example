# 复制为 .env 并填入 `go run ./cmd/keygen` 的输出（切勿提交真实密钥）
VFT_INITIAL_ADMIN_USER=admin
VFT_INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password
VFT_SIGN_KEYS=sign-a:<base64url-seed>,sign-b:<base64url-seed>
VFT_SIGN_ACTIVE_KID=sign-a
VFT_KEX_KEYS=kex-a:<base64url-seed>*,kex-b:<base64url-seed>
VFT_CARD_HMAC_KEY=<base64url-32B>
